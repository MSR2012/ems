# Environment template (named env.example because .env* files are write-protected for the
# coding agent in this repo). Copy to .env to override the demo defaults baked into
# docker-compose.yml. All values below are the compose defaults unless noted.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api

# --- URLs / CORS / CSRF / cookies ---
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# --- Data stores ---
DATABASE_URL=postgres://emp:emp@db:5432/emp
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Google OAuth / Gmail ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/integrations/gmail/callback
GMAIL_SCOPES=openid email https://www.googleapis.com/auth/gmail.readonly
GMAIL_INITIAL_SYNC_DAYS=30
# How often an account becomes due for an incremental sync
GMAIL_SYNC_INTERVAL_SECONDS=300
# How often Celery Beat runs gmail_integration.dispatch_due_syncs
SYNC_DISPATCH_INTERVAL=60
# google | fake (demo mode)
GMAIL_GATEWAY=fake

# --- AI (Jev AI) ---
# jev_ai (Jev directly) | openrouter (Jev via OpenRouter) | fake (demo mode)
AI_PROVIDER=fake
# 1 = analyze each email right after sync imports it; 0 = only via the "Analyze with" button
AUTO_ANALYZE_ON_IMPORT=0
# Jev AI System One (https://thejevai.com/docs#quickstart). JEV_API_KEY is accepted as an alias.
JEV_AI_API_KEY=
JEV_AI_BASE_URL=https://thejevai.com/v1/systemone
JEV_AI_MODEL=jev-latest
# Jev via OpenRouter (AI_PROVIDER=openrouter) — https://openrouter.ai/docs/guides/community/jev
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/systemone
OPENROUTER_MODEL=~typesafe/jev-latest
AI_PROMPT_VERSION=v1
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=300
AI_REQUEST_TIMEOUT_SECONDS=30

# --- Product thresholds ---
SPAM_THRESHOLD_PERCENT=70
URGENCY_THRESHOLD_PERCENT=70

# --- OAuth token encryption (Fernet). Comma-separate keys for rotation; the first encrypts. ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Email (SMTP) for password reset ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Logging / monitoring ---
LOG_LEVEL=INFO
LOG_JSON=0
SENTRY_DSN=

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://api:8000
